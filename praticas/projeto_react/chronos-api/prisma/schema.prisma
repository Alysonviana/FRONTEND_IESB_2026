datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Settings {
  id             Int @id @default(autoincrement())
  workTime       Int
  shortBreakTime Int
  longBreakTime  Int
}

model Task {
  id            String   @id
  name          String
  duration      Int
  type          String
  startDate     BigInt
  completeDate  BigInt?
  interruptDate BigInt?
}
